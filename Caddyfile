# The single edge for every SamantarLabs product.
#
# This file lives here, in the parent repo, because it decides whether all three
# hostnames answer. It used to live in LiveQueue's repo, which meant a routing
# change for the queue console could take the marketing site and MessMate down
# with it — and nobody editing that file would have expected that.
#
# Products do not edit this file. Each one owns exactly one snippet in sites/,
# imported at the bottom. That is the seam: a product changes its own routing
# without opening a file that also describes someone else's.

{
	email {$ACME_EMAIL}
}

# Applied to every site. Defined once here rather than copied into each snippet
# so that adding a header is one edit, not three — and so a product cannot
# quietly ship without them.
(hardened) {
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Told once over HTTPS, a browser refuses to try plain HTTP for this
		# host again. Matters most for links that travel over WhatsApp and get
		# opened on networks nobody controls.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output stdout
		format console
	}
}

# `www` redirects rather than serving the same bytes under a second name: two
# hostnames serving identical content split search ranking between them, and
# anything origin-scoped — storage, cookies, an HSTS entry — is learned twice.
www.{$ROOT_DOMAIN} {
	redir https://{$ROOT_DOMAIN}{uri} permanent
}

# The marketing site. Served straight off a bind mount, no application server in
# front of it: a `git pull` publishes copy changes with no rebuild and no
# restart, and it stays up when every product behind it is down.
{$ROOT_DOMAIN} {
	encode zstd gzip

	root * /srv/landing
	file_server

	import hardened
}

# One file per product, each owned by that product's team. Imported last so the
# snippets above are already defined.
import sites/*.caddy
