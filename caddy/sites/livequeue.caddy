# LiveQueue. Owned by the LiveQueue team; nothing else in this repo depends on
# it, and a mistake here is caught by `deploy/reload.sh` before it reaches the
# running proxy.
#
# Two hostnames, split by audience:
#
#   dev-livequeue   the application — console, waiting-room boards, the patient
#                   tracker, the API and the WhatsApp webhook.
#   clinicqueue     the marketing page, and nothing else.
#
# The landing page is served by the application itself (see `api/spa.py`, which
# answers `/` with `landing.html`), so both hostnames still proxy to the same
# container. The split is enforced here rather than there: `clinicqueue` serves
# the two public pages, `dev-livequeue` rewrites past the marketing page to the
# app shell, and everything else is sent next door.
#
# It has to be enforced here, because this is the only layer that knows which
# hostname was asked for. One container answers both, so a setting in the
# application could only turn the landing page off for both at once.
#
# A redirect, not a 404, because links outlive deployments. A tracker link in a
# patient's WhatsApp, a console bookmarked on a receptionist's tablet, the
# `/login` button on the landing page itself — all of them keep working, and the
# patient who taps a months-old link is the one person who cannot be told about
# a hostname change.

# The application.
dev-livequeue.{$ROOT_DOMAIN} {
	# Everything except the live streams is compressed.
	#
	# This exclusion is not a precaution, it is a fix. Caddy's `encode` matches
	# `text/*` by default, which includes `text/event-stream`, and compressing
	# an SSE stream breaks it in two ways that both look like "the queue froze":
	# the encoder holds the response headers until the first body bytes arrive,
	# so the connection is not established until the first event — and it then
	# holds each event until it has a full compression frame to emit, so events
	# arrive late, batched, or truncated mid-message.
	#
	# `flush_interval -1` below only disables buffering in the *proxy*. The
	# encoder sits in front of it and buffers anyway, which is why that setting
	# alone was not enough.
	#
	# Matched on the path rather than the response's Content-Type because
	# `encode`'s own `match` is an allow-list with no negation. These two routes
	# are the only SSE endpoints the app has — see `api/routers/streams.py`.
	@compressible not path_regexp ^/api/v1/(track|sessions)/[^/]+/stream$
	encode @compressible zstd gzip

	# `/` is the application here, not the marketing page. This hostname is
	# where staff sign in, and a receptionist who bookmarks the bare address
	# should not land on a page selling the product she is already holding.
	#
	# A rewrite rather than `redir / /login`, because the shell is the honest
	# entry point: it exchanges the stored refresh token before deciding
	# anything, so somebody already signed in lands on today's sessions instead
	# of being shown a password prompt they do not need. Signed out, the app
	# sends itself to `/login`.
	#
	# `/index.html` is a real file in the build, so the app serves it without
	# ever reaching its landing-page branch — and `clinicqueue`, which does not
	# rewrite, still gets `landing.html` from the same container.
	rewrite / /index.html

	# `livequeue-api`, not `api`: this proxy is joined to several product
	# networks, and more than one of them has a service called `api`. A bare
	# name resolves ambiguously and lands on whichever stack answers first.
	reverse_proxy livequeue-api:8000 {
		# Server-Sent Events must not be buffered or the console updates in
		# batches — or, worse, sits still until the response is big enough to
		# flush.
		flush_interval -1
		# Long enough that an idle stream is not reaped mid-shift. The client
		# also watches for silence and reconnects, so this is the second line
		# of defence rather than the first.
		transport http {
			read_timeout 1h
		}
	}

	import hardened
}

# The marketing page.
clinicqueue.{$ROOT_DOMAIN} {
	encode zstd gzip

	# The two pages this hostname is for. `/privacy.html` is listed because the
	# landing page links to it, and because it is the address printed in the
	# clinic's own privacy notice — a DPDP disclosure that 301s to a different
	# hostname is a poor look on the one page whose job is to be trustworthy.
	#
	# No SSE exclusion here, and none needed: the streams live under `/api`,
	# which is redirected away before it reaches the encoder.
	@elsewhere not path / /privacy.html
	redir @elsewhere https://dev-livequeue.{$ROOT_DOMAIN}{uri} permanent

	reverse_proxy livequeue-api:8000

	import hardened
}
